# Copy to .env; never commit real secrets.
SECRET_KEY=replace-with-a-long-random-value
DATABASE_URL=sqlite:///services.sqlite3
# PostgreSQL example: DATABASE_URL=postgresql+psycopg://user:password@localhost/services
HOST=0.0.0.0
PORT=9900
MCP_PORT=9901
# --- Shared-certificate HTTPS -------------------------------------------------
# The public HTTPS port and the separate plain-HTTP port that keeps older
# links working. Both are served by their own Gunicorn process.
HTTPS_PUBLIC_PORT=9900
HTTP_PUBLIC_PORT=19900
# The public origin of the site. Canonical links, Open Graph tags and the
# legacy-HTTP upgrade always use this address, never the request's own host.
PUBLIC_ORIGIN=http://localhost:9900
# Path to the certificate bundle of the neighbouring application (private key
# first, then the certificate). It is only read; nothing is written into it.
# Leave empty to let the site discover it automatically.
TLS_CERT_PATH=
# How often, in seconds, the certificate is re-read so that a renewal is
# picked up without a restart.
TLS_WATCH_INTERVAL=300
SITE_URL=http://localhost:9900
UPLOAD_FOLDER=instance/uploads
MAX_UPLOAD_MB=50
COOKIE_SECURE=false
# Enable only behind a correctly configured HTTPS reverse proxy.
ENFORCE_HTTPS=false
# Trust one forwarded-header hop only when the app is unreachable except through that proxy.
TRUST_PROXY_HEADERS=false
# Comma-separated browser origins allowed to call the Agent API.
TRUSTED_ORIGINS=
LOG_LEVEL=INFO
# Optional read-only GitHub token. Leave empty for public unauthenticated API access.
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com
GITHUB_TIMEOUT=20
RATELIMIT_STORAGE_URI=memory://
# Production Redis example: RATELIMIT_STORAGE_URI=redis://localhost:6379/0

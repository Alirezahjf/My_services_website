# Copy to .env; never commit real secrets.
SECRET_KEY=replace-with-a-long-random-value
DATABASE_URL=sqlite:///services.sqlite3
# PostgreSQL example: DATABASE_URL=postgresql+psycopg://user:password@localhost/services
HOST=0.0.0.0
PORT=9900
MCP_PORT=9901
SITE_URL=http://localhost:9900
UPLOAD_FOLDER=instance/uploads
MAX_UPLOAD_MB=50
COOKIE_SECURE=false
LOG_LEVEL=INFO
# Optional read-only GitHub token. Leave empty for public unauthenticated API access.
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com
GITHUB_TIMEOUT=20
RATELIMIT_STORAGE_URI=memory://
# Production Redis example: RATELIMIT_STORAGE_URI=redis://localhost:6379/0
